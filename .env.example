# Local: nada obrigatório (usa ./data/questlog.db + secret dev).
# Produção (Vercel): defina as 3 variáveis abaixo no dashboard (Settings → Environment Variables).

# URL do banco Turso (crie em https://turso.tech → Databases). Ex: libsql://questlog-xxx.turso.io
TURSO_DATABASE_URL=
# Token de acesso do Turso (Database → API Tokens)
TURSO_AUTH_TOKEN=
# Segredo do JWT — gere com: openssl rand -base64 32
JWT_SECRET=
# Local apenas
PORT=3001
